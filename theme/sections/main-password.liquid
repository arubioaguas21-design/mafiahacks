<section class="password">
  <div class="container container--narrow empty">
    <a href="{{ routes.root_url }}" class="logo">{% render 'logo-svg' %}</a>
    <h1 class="h2">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter-wrap' -%}
      <input type="hidden" name="contact[tags]" value="prelanzamiento">
      {%- if form.posted_successfully? -%}
        <p class="form__ok">¡Te avisaremos cuando abramos!</p>
      {%- else -%}
        <div class="newsletter newsletter--light">
          <input type="email" name="contact[email]" placeholder="Tu email" required aria-label="Email">
          <button type="submit" aria-label="Avisarme">→</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="link small">{{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password', class: 'search-form' -%}
        {%- if form.errors -%}<p class="form__error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_label' | t }}" aria-label="{{ 'general.password_page.login_form_password_label' | t }}">
        <button type="submit" class="btn btn--primary">{{ 'general.password_page.login_password_button' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Página con contraseña",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Muy pronto" }
  ]
}
{% endschema %}
