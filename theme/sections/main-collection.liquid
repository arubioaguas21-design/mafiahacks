<section class="section section--tight">
  <div class="container">
    <div class="section__head">
      <div>
        <p class="eyebrow">{{ collection.products_count }} {% if collection.products_count == 1 %}producto{% else %}productos{% endif %}</p>
        <h1 class="h2">{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}<div class="rte muted collection__desc">{{ collection.description }}</div>{%- endif -%}
      </div>
    </div>

    <form class="toolbar collection__toolbar" data-filter-form>
      {%- for filter in collection.filters -%}
        {%- if filter.type == 'list' and filter.values.size > 1 -%}
          <div class="filters" role="group" aria-label="{{ filter.label | escape }}">
            {%- for value in filter.values -%}
              <label class="chip{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                <input type="checkbox" class="visually-hidden" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                {{ value.label | escape }}
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      <select name="sort_by" class="select" aria-label="Ordenar">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
        {%- endfor -%}
      </select>
    </form>

    {%- paginate collection.products by section.settings.per_page -%}
      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- else -%}
          <p class="empty">No hay productos que coincidan. <a href="{{ collection.url }}" class="link">Quitar filtros</a></p>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
