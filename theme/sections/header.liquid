<header class="header" data-header>
  <div class="container header__inner">
    <a href="{{ routes.root_url }}" class="logo">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_style = 'max-width: ' | append: section.settings.logo_width | append: 'px' -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'logo__img', style: logo_style, widths: '200, 300, 400' }}
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name | escape }}<span>.</span>
      {%- endif -%}
    </a>

    <nav class="nav" id="SiteNav" aria-label="Principal">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    </nav>

    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-btn hide-mobile" aria-label="Mi cuenta">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-btn cart-btn" aria-label="Carrito ({{ cart.item_count }})">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
      <button class="menu-btn" type="button" aria-controls="SiteNav" aria-expanded="false" aria-label="Menú" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Cabecera",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "text", "id": "logo_text", "label": "Texto del logo (si no hay imagen)", "default": "colorcalle" },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
