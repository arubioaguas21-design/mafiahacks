<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__head"><h2>{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a href="{{ col.url | default: routes.all_products_collection_url }}" class="cat" {{ block.shopify_attributes }}>
          <div class="cat__img" style="background: {{ block.settings.bg }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 45vw' }}
            {%- elsif col.featured_image -%}
              {{ col.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 45vw' }}
            {%- else -%}
              {% render 'garment', type: block.settings.fallback, color: block.settings.fallback_color %}
            {%- endif -%}
          </div>
          <div class="cat__body">
            <h3>{{ block.settings.title | default: col.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            <span class="link">{{ block.settings.link_label | escape }} →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorías",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título", "default": "Camisetas" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Básicas, oversize y manga larga." },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Ver camisetas" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "color", "id": "bg", "label": "Fondo de la imagen", "default": "#ece8df" },
        { "type": "select", "id": "fallback", "label": "Ilustración si no hay imagen", "options": [{ "value": "tee", "label": "Camiseta" }, { "value": "hoodie", "label": "Sudadera" }], "default": "tee" },
        { "type": "color", "id": "fallback_color", "label": "Color de la ilustración", "default": "#c8102e" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Categorías", "blocks": [{ "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
