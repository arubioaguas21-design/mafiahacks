{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="Paginación">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="chip" aria-label="Anterior">←</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="chip">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="chip is-active" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="chip chip--plain">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="chip" aria-label="Siguiente">→</a>{%- endif -%}
  </nav>
{%- endif -%}
